@model RiskConfigViewModel
@{
    ViewData["Title"] = "Ngưỡng rủi ro";
}

<h2 class="mb-1">Ngưỡng rủi ro</h2>
<p class="text-muted small">
    Mức rủi ro: <strong>High</strong> nếu xác suất ≥ ngưỡng High; <strong>Medium</strong> nếu ≥ ngưỡng Medium; còn lại <strong>Low</strong>.
    Ngưỡng mới chỉ áp cho các dự báo thực hiện sau khi lưu; mức rủi ro đã lưu trước đây giữ nguyên.
</p>

@if (TempData["ThanhCong"] is string thanhCong)
{
    <div class="alert alert-success">@thanhCong</div>
}
@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-warning">@thongBao</div>
}

@if (!string.IsNullOrEmpty(Model.ThongBaoThieuKhoa))
{
    <div class="alert alert-danger">@Model.ThongBaoThieuKhoa</div>
}
else
{
    <form asp-action="Index" method="post" style="max-width: 520px;">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="MediumText" class="form-label">Ngưỡng Medium</label>
            <input asp-for="MediumText" class="form-control" autocomplete="off" />
            <span asp-validation-for="MediumText" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="HighText" class="form-label">Ngưỡng High</label>
            <input asp-for="HighText" class="form-control" autocomplete="off" />
            <span asp-validation-for="HighText" class="text-danger"></span>
        </div>

        <p class="text-muted small">
            Cập nhật gần nhất: @HienThi.Ngay(Model.CapNhatLuc)
            @if (!string.IsNullOrEmpty(Model.CapNhatBoi))
            {
                <span>bởi @Model.CapNhatBoi</span>
            }
            else
            {
                <span>(giá trị khởi tạo do script đăng ký mô hình ghi)</span>
            }
        </p>

        <button type="submit" class="btn btn-primary">Lưu</button>
    </form>
}