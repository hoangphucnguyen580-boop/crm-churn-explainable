@model TicketCreateModel
@{
    ViewData["Title"] = "Mở ticket";
}

<h2 class="mb-1">Mở ticket</h2>
<p class="text-muted small">
    Ticket mới có trạng thái <strong>Open</strong>, thời điểm tạo là giờ hiện tại (hệ thống tự gán)
    và chưa có người phụ trách. Phân công và chuyển InProgress làm ở trang chi tiết ticket.
</p>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="CustomerId" class="form-label">Mã khách</label>
            <input asp-for="CustomerId" class="form-control" maxlength="20" />
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Category" class="form-label">Loại ticket</label>
            <select asp-for="Category" asp-items="@(new SelectList(DanhMucTicket.Loai))" class="form-select">
                <option value="">-- Chọn --</option>
            </select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Priority" class="form-label">Mức ưu tiên</label>
            <select asp-for="Priority" asp-items="@(new SelectList(DanhMucTicket.UuTien))" class="form-select">
                <option value="">-- Chọn --</option>
            </select>
            <span asp-validation-for="Priority" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}