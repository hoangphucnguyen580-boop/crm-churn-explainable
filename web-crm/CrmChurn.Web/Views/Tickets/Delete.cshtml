@model TicketDetailViewModel
@{
    ViewData["Title"] = "Xóa ticket " + Model.TicketId;
}

<h2 class="mb-3">Xóa ticket @Model.TicketId</h2>

<div class="alert alert-warning">
    Ticket này sẽ bị <strong>xóa hẳn</strong>. Giá trị cũ được lưu trong nhật ký thao tác.
</div>

<dl class="row">
    <dt class="col-sm-2">Khách</dt>
    <dd class="col-sm-10">@Model.CustomerId</dd>
    <dt class="col-sm-2">Loại</dt>
    <dd class="col-sm-10">@Model.Category</dd>
    <dt class="col-sm-2">Ưu tiên</dt>
    <dd class="col-sm-10">@Model.Priority</dd>
    <dt class="col-sm-2">Trạng thái</dt>
    <dd class="col-sm-10">
        @Model.Status
        @if (Model.IsSimulated)
        {
            <span class="badge bg-secondary">dữ liệu mô phỏng</span>
        }
    </dd>
    <dt class="col-sm-2">Tạo lúc</dt>
    <dd class="col-sm-10">@HienThi.Ngay(Model.CreatedAt)</dd>
    <dt class="col-sm-2">Phụ trách</dt>
    <dd class="col-sm-10">@(Model.AssignedName ?? "Chưa phân công")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.TicketId" method="post" class="d-flex gap-2">
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a asp-action="Details" asp-route-id="@Model.TicketId" class="btn btn-outline-secondary">Hủy</a>
</form>