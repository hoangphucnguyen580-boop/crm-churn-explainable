@model TicketReopenModel
@{
    var tk = ViewData["Ticket"] as TicketDetailViewModel;
    string maTicket = ViewData["TicketId"]?.ToString() ?? tk?.TicketId.ToString() ?? "";
    ViewData["Title"] = "Mở lại ticket " + maTicket;
}

<h2 class="mb-3">Mở lại ticket @maTicket</h2>

<div class="alert alert-warning">
    Ticket sẽ quay về trạng thái <strong>InProgress</strong>. <strong>Thời điểm đóng và điểm hài lòng sẽ bị xóa</strong>;
    kết quả giải quyết cũ được giữ lại và sẽ bị ghi đè ở lần đóng sau. Giá trị cũ vẫn lưu trong nhật ký thao tác.
</div>

@if (tk != null)
{
    <p class="text-muted small">
        Khách @tk.CustomerId, đóng lúc @HienThi.Ngay(tk.ClosedAt), điểm hài lòng @(tk.SatisfactionScore?.ToString() ?? "—").
    </p>
}

<form asp-action="Reopen" asp-route-id="@maTicket" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <input type="hidden" asp-for="TrangThaiLucMo" />

    <div class="mb-3">
        <label asp-for="Reason" class="form-label">Lý do mở lại (bắt buộc)</label>
        <textarea asp-for="Reason" class="form-control" rows="3" maxlength="500"></textarea>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-warning">Xác nhận mở lại</button>
        <a asp-action="Details" asp-route-id="@maTicket" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}