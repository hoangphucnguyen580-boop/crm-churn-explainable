@model PredictionResultViewModel
@{
    ViewData["Title"] = "Kết quả dự báo " + Model.PredictionId;
}

@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-warning">@thongBao</div>
}

<div class="alert alert-success">
    Đã dự báo và lưu kết quả (mã @Model.PredictionId).
</div>

<h2 class="mb-3">
    Kết quả dự báo churn
    <span class="badge @HienThi.LopRuiRo(Model.RiskLevel) fs-6">@HienThi.NhanRuiRo(Model.RiskLevel)</span>
</h2>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Kết quả</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Khách hàng</dt>
                    <dd class="col-sm-7">
                        @if (Model.CustomerId != null)
                        {
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.CustomerId</a>
                        }
                        else
                        {
                            <span>Nhập thủ công (không gắn với khách nào)</span>
                        }
                    </dd>
                    <dt class="col-sm-5">Xác suất churn</dt>
                    <dd class="col-sm-7"><strong>@Model.Probability.ToString("0.0000")</strong></dd>
                    <dt class="col-sm-5">Mức rủi ro</dt>
                    <dd class="col-sm-7">@HienThi.NhanRuiRo(Model.RiskLevel) (theo ngưỡng cấu hình lúc dự báo)</dd>
                    <dt class="col-sm-5">Mô hình</dt>
                    <dd class="col-sm-7">@Model.ModelName (@Model.ModelVersion)</dd>
                    <dt class="col-sm-5">Thời điểm dự báo</dt>
                    <dd class="col-sm-7">@HienThi.Ngay(Model.PredictionTime)</dd>
                    @if (Model.ApiMs != null)
                    {
                        <dt class="col-sm-5">Thời gian suy luận (trong API)</dt>
                        <dd class="col-sm-7">@Model.ApiMs ms</dd>
                        <dt class="col-sm-5">Thời gian toàn chuỗi gọi</dt>
                        <dd class="col-sm-7">@Model.TongMs ms</dd>
                    }
                </dl>
                <p class="text-muted small mt-2 mb-0">
                    Điểm này chỉ hỗ trợ nhân viên chăm sóc khách hàng quyết định, <strong>không phải nguyên nhân</strong>
                    khiến khách rời bỏ. Mô hình được huấn luyện trên bộ dữ liệu mẫu IBM Telco, không phải hiệu năng trên dữ liệu thực.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">19 đặc trưng đã gửi tới mô hình</div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var d in Model.DacTrung)
                            {
                                <tr><td>@d.Cot</td><td>@d.GiaTri</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    @if (Model.CustomerId != null)
    {
        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-outline-primary">Về chi tiết khách</a>
    }
    <a asp-action="Index" class="btn btn-outline-secondary">Dự báo khác</a>
</div>